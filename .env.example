# =============================================================================
# ASHA SAKHI - Global Environment Configuration Reference
# =============================================================================

# Frontend Google Maps Platform API Key
# Enable: Maps JavaScript API, Directions API, Places API
# High-fidelity vector terrain map is used if left blank
VITE_GOOGLE_MAPS_API_KEY=

# Frontend Endpoints
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/voice
VITE_DEMO_MODE=true

# Backend Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
DATABASE_URL=sqlite:///./asha_sakhi.db

# Speech & AI Providers
ASR_PROVIDER=mock
TTS_PROVIDER=mock
GEMINI_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
