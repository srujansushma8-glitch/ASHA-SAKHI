# =============================================================================
# ASHA SAKHI - Global Environment Configuration Reference
# =============================================================================

# Frontend Google Maps Platform API Key
# Enable: Maps JavaScript API, Directions API, Places API
# High-fidelity vector terrain map is used if left blank
VITE_GOOGLE_MAPS_API_KEY=

# Frontend Endpoints
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/voice
VITE_DEMO_MODE=true

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
APP_NAME="ASHA Sakhi Voice Field Register"
APP_ENV=development
DEBUG=true

# Authentication & Security
# In production, JWT_SECRET_KEY MUST be provided via environment variables
JWT_SECRET_KEY=change_me_to_a_secure_random_key_in_production
ENABLE_DEMO_AUTH=true

# Database Configuration (matching backend/app/config.py)
DATABASE_PATH=data/asha_sakhi.db
DATABASE_URL=sqlite:///./data/asha_sakhi.db

# Speech & AI Providers (matching backend/app/config.py)
ASR_MODE=mock
AI4BHARAT_ASR_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
AI4BHARAT_API_KEY=
AI4BHARAT_USER_ID=
AI4BHARAT_ASR_SERVICE_ID=bhashini/ai4bharat/conformer-multilingual-asr

TTS_MODE=mock
AI4BHARAT_TTS_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
AI4BHARAT_TTS_SERVICE_ID=bhashini/ai4bharat/indic-tts-kn
AI4BHARAT_TTS_GENDER=female

EXTRACTION_MODE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

DANGER_DETECTION_STRICT_MODE=true
FUZZY_MATCH_THRESHOLD=85
