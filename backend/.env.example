# Environment Configuration for ASHA Sakhi Backend

# Application Settings
APP_NAME=ASHA Sakhi Voice Field Register
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./data/asha_sakhi.db

# Speech Recognition (AI4Bharat Indic-Transcribe / IndicConformer / Hosted Dhruva API)
# Mode options: "mock", "ai4bharat_hosted", "indic_transcribe_local"
ASR_MODE=mock
AI4BHARAT_ASR_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
AI4BHARAT_API_KEY=
AI4BHARAT_USER_ID=
AI4BHARAT_ASR_SERVICE_ID=bhashini/ai4bharat/conformer-multilingual-asr

# Speech Generation (AI4Bharat Indic-Speak / Indic-TTS / Hosted Dhruva API)
# Mode options: "mock", "ai4bharat_hosted", "indic_tts_local"
TTS_MODE=mock
AI4BHARAT_TTS_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
AI4BHARAT_TTS_SERVICE_ID=bhashini/ai4bharat/indic-tts-kn
AI4BHARAT_TTS_GENDER=female

# Information Extraction (LLM + Deterministic Fallback)
# Extractor options: "deterministic", "gemini", "auto" (uses gemini if key present, else deterministic)
EXTRACTION_MODE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Danger Signs & Safety
DANGER_DETECTION_STRICT_MODE=True
FUZZY_MATCH_THRESHOLD=85
MAX_AUDIO_CHUNK_BYTES=1048576
