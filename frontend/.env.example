# =============================================================================
# ASHA SAKHI - Frontend Environment Configuration
# =============================================================================

# Google Maps Platform API Key (Optional for demo, recommended for live GPS map)
# Enable: Maps JavaScript API, Directions API, Places API, Geocoding API
# If omitted or unconfigured, ASHA Sakhi automatically renders the high-fidelity
# vector terrain map with full HUD GPS telemetry and waypoints.
VITE_GOOGLE_MAPS_API_KEY=

# Application & API Endpoints
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/voice

# Evaluation & Simulation Mode
VITE_DEMO_MODE=true

# AI4Bharat Speech Recognition & Synthesis Models
VITE_ASR_MODEL=AI4Bharat Indic-Transcribe (Kannada)
VITE_TTS_MODEL=AI4Bharat Indic-Speak (Kannada)
